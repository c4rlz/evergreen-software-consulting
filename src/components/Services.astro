---
import { services } from '../content/site';
import Section from './Section.astro';
---

<Section id="services" title="What I help with">
  <ul class="grid" role="list">
    {
      services.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem 2.5rem;
  }
  li {
    padding-top: 1rem;
    border-top: 2px solid var(--moss);
  }
  p {
    margin: 0;
    color: var(--text-muted);
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
