---
// Static evergreen ridge under the hero. Phase 2's p5.js forest replaces it
// when motion is allowed; this stays as the fallback.
const trees = [
  { x: 2, h: 70 }, { x: 9, h: 95 }, { x: 15, h: 60 }, { x: 22, h: 110 },
  { x: 30, h: 80 }, { x: 37, h: 100 }, { x: 44, h: 65 }, { x: 52, h: 120 },
  { x: 60, h: 85 }, { x: 67, h: 105 }, { x: 74, h: 70 }, { x: 81, h: 115 },
  { x: 89, h: 90 }, { x: 96, h: 75 },
];
const W = 1000;
const H = 140;

function tree(cx: number, h: number) {
  const w = h * 0.42;
  const base = H;
  const top = base - h;
  // Three stacked tiers, each a little narrower than the one below.
  return [0, 1, 2]
    .map((i) => {
      const tierTop = top + (h * i) / 4.2;
      const tierBase = top + (h * (i + 1.6)) / 3.2;
      const half = (w / 2) * (0.55 + i * 0.25);
      return `M${cx} ${tierTop}L${cx - half} ${Math.min(tierBase, base)}L${cx + half} ${Math.min(tierBase, base)}Z`;
    })
    .join('');
}
---

<svg class="treeline" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d={`M0 ${H - 18} Q ${W / 4} ${H - 34} ${W / 2} ${H - 20} T ${W} ${H - 26} V ${H} H 0 Z`} class="hill" />
  {trees.map((t) => <path d={tree((t.x / 100) * W, t.h)} class="tree" />)}
</svg>

<style>
  .treeline {
    display: block;
    width: 100%;
    height: clamp(70px, 14vw, 140px);
  }
  .hill {
    fill: var(--moss);
    opacity: 0.35;
  }
  .tree {
    fill: var(--evergreen);
  }
</style>
