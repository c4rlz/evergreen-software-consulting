---
import { contact } from '../content/site';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">Let’s talk</h2>
    <p>{contact.intro}</p>
    <div class="actions">
      {contact.email && <a class="button" href={`mailto:${contact.email}`}>{contact.email}</a>}
      {contact.bookingUrl && <a class="button button--ghost" href={contact.bookingUrl}>Book a short intro call</a>}
    </div>
    <ul class="links" role="list">
      {
        contact.links.map((l) => (
          <li>
            <a href={l.href} rel="me">{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    background: var(--evergreen);
    color: var(--cream);
    border-top: none;
  }
  .contact h2 {
    color: var(--cream);
  }
  .contact a {
    color: var(--cream);
  }
  .contact .button {
    background: var(--cream);
    color: var(--evergreen);
  }
  .contact .button--ghost {
    background: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 2px var(--cream);
  }
  .contact :focus-visible {
    outline-color: var(--cream);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  .actions:empty {
    display: none;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 1.1rem;
  }
</style>
