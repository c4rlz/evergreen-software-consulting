---
import { contact } from '../content/site';
import Section from './Section.astro';

// Email is the main way in once it exists; until then, the first link is.
const primary = contact.email
  ? { label: 'Email me', href: `mailto:${contact.email}` }
  : { label: `Message me on ${contact.links[0].label}`, href: contact.links[0].href };
const secondary = contact.email ? contact.links : contact.links.slice(1);
---

<Section id="contact" title="Let’s talk" class="contact">
  <p class="intro">{contact.intro}</p>
  <div class="actions">
    <a class="button" href={primary.href} rel="me">{primary.label}</a>
    {contact.bookingUrl && <a class="button button--ghost" href={contact.bookingUrl}>Book an intro call</a>}
    {
      secondary.map((l) => (
        <a class="text-link" href={l.href} rel="me">
          {l.label}
        </a>
      ))
    }
  </div>
  {contact.email && <p class="email">{contact.email}</p>}
</Section>

<style>
  /* The section element belongs to Section.astro, so reach it globally. */
  :global(.section.contact) {
    background: var(--evergreen);
    color: var(--cream);
    border-top: none;
  }
  :global(.section.contact h2) {
    color: var(--cream);
  }
  :global(.section.contact :focus-visible) {
    outline-color: var(--cream);
  }
  .intro {
    font-size: 1.2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }
  .button {
    background: var(--cream);
    color: var(--evergreen);
  }
  .button:hover {
    background: var(--fog);
  }
  .button--ghost {
    background: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 2px var(--cream);
  }
  .text-link {
    color: var(--cream);
    font-weight: 600;
  }
  .email {
    margin: 1rem 0 0;
    color: var(--fog);
  }
</style>
