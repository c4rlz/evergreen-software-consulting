---
import { hero, site } from '../content/site';
import Treeline from './Treeline.astro';

// Odd-indexed parts were inside *asterisks*.
const headline = hero.headline.split(/\*(.+?)\*/);
---

<header class="hero">
  <nav class="container nav" aria-label="Primary">
    <a class="wordmark" href="/">{site.shortName}</a>
    <a href="#contact">Contact</a>
  </nav>
  <div class="container intro">
    <p class="status"><span class="dot" aria-hidden="true"></span>{hero.status}</p>
    <h1>{headline.map((part, i) => (i % 2 ? <em>{part}</em> : part))}</h1>
    <p class="sub">{hero.sub}</p>
    <div class="actions">
      <a class="button" href="#contact">{hero.cta}</a>
      <a class="button button--ghost" href="#work">See my work</a>
    </div>
  </div>
  <Treeline />
</header>

<style>
  .hero {
    background: color-mix(in srgb, var(--fog) 45%, var(--cream));
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
  }
  .nav a {
    color: var(--evergreen);
    font-weight: 600;
    text-decoration: none;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  .wordmark {
    font-family: var(--font-heading);
    font-size: 1.35rem;
  }
  .intro {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(2rem, 6vw, 3.5rem);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--moss) 25%, transparent);
  }
  h1 {
    font-size: clamp(2.5rem, 7.5vw, 4.5rem);
    max-width: 13ch;
    margin: 0 0 1.25rem;
    letter-spacing: -0.01em;
  }
  h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--moss);
  }
  .sub {
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 44ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
